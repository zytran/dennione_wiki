<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <% const serverErrors = (typeof errors !== 'undefined' && errors) ? errors : []; %>

    <main class="loginpage" aria-labelledby="reset-heading">
        <h1 id="reset-heading">Reset Password</h1>

        <% if (token) { %>
        <form id="resetForm" action="/reset-password/<%= token %>" method="POST" novalidate>
            <div class="login glass">

                <% if (serverErrors.length) { %>
                    <div class="error server-error" role="alert">
                        <% serverErrors.forEach(function (e) { %><p><%= e %></p><% }) %>
                    </div>
                <% } %>

                <label for="password" class="sr-only">New password</label>
                <div class="input-wrapper lock-wrapper">
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="New password"
                        minlength="8"
                        maxlength="50"
                        autocomplete="new-password"
                        required
                    />
                    <span class="input-icon lock-icon" aria-hidden="true"></span>
                </div>

                <label for="confirm" class="sr-only">Confirm new password</label>
                <div class="input-wrapper lock-wrapper">
                    <input
                        type="password"
                        id="confirm"
                        name="confirm"
                        placeholder="Confirm new password"
                        minlength="8"
                        maxlength="50"
                        autocomplete="new-password"
                        required
                    />
                    <span class="input-icon lock-icon" aria-hidden="true"></span>
                </div>
            </div>

            <div class="submit">
                <button type="submit" class="login-btn">Set New Password</button>
            </div>
        </form>
        <% } else { %>
        <div class="login glass">
            <% if (serverErrors.length) { %>
                <div class="error server-error" role="alert">
                    <% serverErrors.forEach(function (e) { %><p><%= e %></p><% }) %>
                </div>
            <% } %>
        </div>

        <div class="no-account">
            <a href="/forgot-password">Request a new reset link</a>
        </div>
        <% } %>
    </main>
    <script src="../public/js/reset.js"></script>
    <%- include('partials/footer') %>
</body>
</html>
