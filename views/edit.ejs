<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { useEditor: true, headTitle: 'Edit: ' + title }) %>
<link rel="stylesheet" href="https://uicdn.toast.com/editor/3.2.2/toastui-editor.min.css">
<link rel="stylesheet" href="https://uicdn.toast.com/editor/3.2.2/theme/toastui-editor-dark.css">
</head>
<body>
<%- include('partials/navbar') %>

<main class="content">
  <div class="container">
    <h1>Editing: <%= title %></h1>

    <form method="POST" id="page-form">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" value="<%= page?.title || '' %>" required>

      <%- include('partials/markdown-instructions') %>
      
      <label>Content</label>
      <div id="editor"></div>
      <input type="hidden" name="content" id="content">
      <%- include('partials/infobox-editor') %>
      <button type="submit">Save</button>
    </form>

    <div class="actions">
      <a href="/<%= slug %>">Cancel</a>
      <button class="delete-btn" onclick="confirmDelete()">Delete Page</button>
    </div>
  </div>
</main>


<%- include('partials/footer', { useEditor: true }) %>

<script src="https://uicdn.toast.com/editor/3.2.2/toastui-editor-all.min.js"></script>

<script>
  const initial = <%- JSON.stringify(page?.content || '').replace(/</g, '\\u003c') %>;

  const editor = new toastui.Editor({
    el: document.getElementById('editor'),
    height: '500px',
    initialEditType: 'wysiwyg',
    hideModeSwitch: true,
    previewStyle: 'tab',
    initialValue: initial,
    usageStatistics: false
});

  function syncTheme() {
    const ui = document.querySelector('#editor .toastui-editor-defaultUI');
    if (ui) ui.classList.toggle('toastui-editor-dark',
      document.documentElement.dataset.theme === 'dark');
  }
  syncTheme();
  new MutationObserver(syncTheme)
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  const form = document.getElementById('page-form');
  const hidden = document.getElementById('content');

  form.addEventListener('submit', (event) => {
  hidden.value = editor.getMarkdown();
});

  function confirmDelete() {
    const input = prompt("This will permanently delete this page.\n\nType 'confirm' to continue:");
    if (input !== 'confirm') {
      alert('Deletion cancelled.');
      return;
    }

    fetch('/<%= slug %>/delete', { method: 'POST' })
      .then(() => { window.location.href = '/'; })
      .catch(() => { alert('Failed to delete page.'); });
  }
</script>
</body>
</html>
