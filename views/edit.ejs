<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { useEditor: true, headTitle: 'Edit: ' + title }) %>
</head>
<body>
<%- include('partials/navbar') %>

<main class="content">
  <div class="container">
    <h1>Editing: <%= title %></h1>

    <form method="POST">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" value="<%= page?.title || '' %>" required>

      <%- include('partials/markdown-instructions') %>

      <textarea id="editor" name="content"><%= content %></textarea>
      <button type="submit">Save</button>
    </form>

    <div class="actions">
      <a href="/<%= slug %>">Cancel</a>
      <button class="delete-btn" onclick="confirmDelete()">Delete Page</button>
    </div>
  </div>
</main>

<%- include('partials/footer', { useEditor: true }) %>

<script>
  const simplemde = new SimpleMDE({
    element: document.getElementById('editor'),
    spellChecker: true,
    status: false,
    autosave: {
      enabled: true,
      uniqueId: 'wiki-editor-<%= slug %>',
      delay: 1000
    }
  });

  function confirmDelete() {
    const input = prompt("This will permanently delete this page.\n\nType 'confirm' to continue:");
    if (input !== 'confirm') {
      alert('Deletion cancelled.');
      return;
    }

    fetch('/<%= slug %>/delete', { method: 'POST' })
      .then(() => { window.location.href = '/'; })
      .catch(() => { alert('Failed to delete page.'); });
  }
</script>
</body>
</html>
