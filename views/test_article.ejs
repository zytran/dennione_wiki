<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>

  <style>
    body {
      font-family: system-ui, Arial, sans-serif;
      max-width: 800px;
      margin: 2rem auto;
      line-height: 1.6;
      background-color: #f9f9f9;
      color: #111;
      transition: background-color 0.3s, color 0.3s;
    }

    .dark_mode{
        background-color: #333;
        color: #f9f9f9;   
    }
    .dark_mode h1{
        color: #f9f9f9;
    }
    .dark_mode .editor-toolbar,
    .dark_mode .CodeMirror{
        background-color: #222;
        color: #eee;
    }
    .dark_mode .CodeMirror-cursor{
        border-left: 1px solid #fff;
    }
    .dark_mode .actions a{
        background-color: #444;
        color:#eee;
        border-color: #666 ;
    }

    .dark_toggle{
        position: fixed;
        top: 1rem;
        right: 1rem;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }

    h1 {
      text-align: center;
      color: #333;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
    }

    button {
      width: 120px;
      padding: 0.5rem;
      font-size: 1rem;
      border: none;
      border-radius: 4px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
    }

    button:hover {
      background-color: #45a049;
    }

    .actions {
      margin-top: 1rem;
    }

    .actions a {
      text-decoration: none;
      color: #555;
      padding: 0.5rem 1rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      background-color: #eee;
    }

    .actions a:hover {
      background-color: #ddd;
    }

 .theme_toggle {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 9999;
  cursor: pointer;
}

.toggle_track {
  width: 64px;
  height: 32px;
  background: #ddd;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6px;
  position: relative;
}

.toggle_thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 26px;
  height: 26px;
  background: white;
  border-radius: 50%;
  transition: transform 0.3s ease;
}

.dark_mode .toggle_thumb {
  transform: translateX(45px);
}


.icon {
    width: 16px;
    height: 16px;
  font-size: 14px;
  z-index: 1;
}
.sun,
.moon {
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.dark_mode .sun {
  opacity: 0.3;
}

.dark_mode .moon {
  opacity: 1;
}

body:not(.dark_mode) .sun {
  opacity: 1;
}

body:not(.dark_mode) .moon {
  opacity: 0.3;
}

.dark_mode .toggle_track {
  background: #555;
}

  </style>
</head>

<body>
  
 
  <div class = "theme_toggle" onclick="dark_mode()">
    <div class="toggle_track">
        <img src ="/icons/sun.svg" class="icon sun" alt="Light Mode">
        <img src ="/icons/moon.svg" class = "icon moon" alt="Dark Mode">
        <div class="toggle_thumb"></div>
    </div>
</div>

  <header>
    <h1><%- title %></h1>
  </header>

  <main>
    <p>This is a test EJS page.</p>

    <p><a href="/wiki/<%= title.replace(/ /g,'-') %>/edit">Edit this page</a></p>
    <p><strong>Message from server:</strong></p>
    <div>
      <%- message %>
    </div>
  </main>

  <footer>
    <p>created by ysa</p>
  </footer>

  <script>
    function dark_mode() {
        document.body.classList.toggle("dark_mode");

        localStorage.setItem("darkMode", document.body.classList.contains("dark_mode"));
    }

    if (localStorage.getItem("darkMode")==="true"){
        document.body.classList.add("dark_mode")
    }
</script>
</body>
</html>
