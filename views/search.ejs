<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { headTitle: `Search results for "${query}"` }) %>
</head>
<body>
<%- include('partials/navbar') %>

<main class="content">
  <div class="container">
    <h1>Search results for "<%= query %>"</h1>

    <% if (results.length === 0) { %>
      <p>No pages found.</p>
    <% } else { %>
      <ul>
        <% results.forEach(page => { %>
          <li><a href="/<%= page.slug %>"><%= page.title %></a></li>
        <% }) %>
      </ul>
    <% } %>

    <p><a href="/">Back to home</a></p>
  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
