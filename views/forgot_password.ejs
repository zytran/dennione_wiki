<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="loginpage" aria-labelledby="forgot-heading">
        <h1 id="forgot-heading">Forgot Password</h1>

        <form id="forgotForm" action="/forgot-password" method="POST" novalidate>
            <div class="login glass">

                <% if (typeof errors !== 'undefined' && errors.length) { %>
                    <div class="error server-error" role="alert">
                        <% errors.forEach(function (e) { %><p><%= e %></p><% }) %>
                    </div>
                <% } %>

                <% if (typeof message !== 'undefined' && message) { %>
                    <div class="success" role="status"><p><%= message %></p></div>
                <% } %>

                <label for="email" class="sr-only">Email</label>
                <div class="input-wrapper mail-wrapper">
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Email"
                        maxlength="100"
                        autocomplete="email"
                        value="<%= (typeof values !== 'undefined' && values.email) || '' %>"
                        required
                    />
                    <span class="input-icon mail-icon" aria-hidden="true"></span>
                </div>
            </div>

            <div class="submit">
                <button type="submit" class="login-btn">Send Reset Link</button>
            </div>
        </form>

        <div class="no-account">
            <p>Remembered it?</p>
            <a href="/login">Back to login</a>
        </div>
    </main>
    <script src="../public/js/forgot.js"></script>
    <%- include('partials/footer') %>
</body>
</html>
