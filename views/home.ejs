<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="icon" href="/icons/favicon.ico" type="image/x-icon">
  <style>
    body {
      height: 100%;
      font-family: Arial, sans-serif;
      line-height: 1.6;
      background-color: #f9f9f9;
      display:flex;
      flex-direction: column;
      min-height: 100%;
    }.dark_mode{
        background-color: #333;
        color: #f9f9f9;   
    }
    .dark_mode h1{
        color: #f9f9f9;
    }
    .dark_mode .editor-toolbar,
    .dark_mode .CodeMirror{
        background-color: #222;
        color: #eee;
    }
    .dark_mode .CodeMirror-cursor{
        border-left: 1px solid #fff;
    }
    .dark_mode .actions a{
        background-color: #444;
        color:#eee;
        border-color: #666 ;
    }

    .dark_toggle{
        position: fixed;
        top: 1rem;
        right: 1rem;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }
   
.dark_mode .editor-toolbar {
  background-color: #2b2b2b;
  border-color: #444;
}

.dark_mode .editor-toolbar button {
  color: #ddd;
}

.dark_mode .editor-toolbar button:hover {
  background-color: #3a3a3a;
}

.dark_mode .CodeMirror {
  background-color: #1e1e1e;
  color: #f9f9f9;
  border-color: #444;
}

.dark_mode .CodeMirror-gutters {
  background-color: #1e1e1e;
  border-right: 1px solid #444;
}

.dark_mode .CodeMirror-cursor {
  border-left: 1px solid #fff;
}

.dark_mode .CodeMirror-selected {
  background-color: #555 !important;
}

.dark_mode .CodeMirror-line::selection,
.dark_mode .CodeMirror-line > span::selection {
  background-color: #555;
}


    h1 {
      text-align: center;
      color: #333;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
    }

    button {
      width: 120px;
      padding: 0.5rem;
      font-size: 1rem;
      border: none;
      border-radius: 4px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
    }

    button:hover {
      background-color: #45a049;
    }

    .actions {
      margin-top: 1rem;
    }

    .actions a {
      text-decoration: none;
      color: #555;
      padding: 0.5rem 1rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      background-color: #eee;
    }

    .actions a:hover {
      background-color: #ddd;
    }

 .theme_toggle {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 9999;
  cursor: pointer;
}

.toggle_track {
  width: 64px;
  height: 32px;
  background: #ddd;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6px;
  position: relative;
}

.toggle_thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 26px;
  height: 26px;
  background: white;
  border-radius: 50%;
  transition: transform 0.3s ease;
}

.dark_mode .toggle_thumb {
  transform: translateX(45px);
}


.icon {
    width: 16px;
    height: 16px;
  font-size: 14px;
  z-index: 1;
}
.sun,
.moon {
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.dark_mode .sun {
  opacity: 0.3;
}

.dark_mode .moon {
  opacity: 1;
}

body:not(.dark_mode) .sun {
  opacity: 1;
}

body:not(.dark_mode) .moon {
  opacity: 0.3;
}

.dark_mode .toggle_track {
  background: #555;
}
.home-logo-link {
  position: fixed;   
  top: 1rem;         
  left: 1rem;        
  z-index: 1000;     
}

.home-logo {
  width: 144px;       
  height: 144px;
  cursor: pointer;   
  transition: opacity 0.3s;
}

.home-logo-link:hover .home-logo {
  opacity: 0.8;      
}
.search-form {
  position: relative;
  max-width: 500px;
  margin: 0 auto;
}

.search-form input[type="text"] {
  width: 100%;
  padding: 0.5rem 2.5rem 0.5rem 0.5rem; /* room for icon */
  font-size: 1rem;
  border: 1px solid #ccc;
  border-radius: 4px;
}

.search-form .search-btn {
  position: absolute;
  right: -5.75rem;
  top: 50%;
  transform: translateY(-50%);
  border: none;
  background: none;
  cursor: pointer;
  color: #555;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-form .search-btn svg {
  width: 20px;
  height: 20px;
}

.search-form .search-btn:hover svg {
  color: #000;
}
.search-icon{
    width:50px;
    height:50px;
}

    .btn-create {
      width: 120px;
      padding: 0.5rem;
      font-size: 1rem;
      border: none;
      border-radius: 4px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
    }

    .btn-create:hover {
      background-color: #45a049;
    }
    p.centered{
    text-align:center;
}

.container {
  max-width: 800px;
  margin: 2rem auto;
  padding: 1rem;
}

.content {
  flex: 1;
}


footer {
  width: 100vw;
  background-color: #f9f9f9;
  color: #333;
}


.footer-inner {
  max-width: 100%;
  margin: 0 auto;
  padding: 1rem;
  text-align: center;
}
.dark_mode footer {
  background-color: #333;
  color: #f9f9f9;
}



  </style>
</head>
<body>
    <div class = "theme_toggle" onclick="dark_mode()">
    <div class="toggle_track">
        <img src ="/icons/sun.svg" class="icon sun" alt="Light Mode">
        <img src ="/icons/moon.svg" class = "icon moon" alt="Dark Mode">
        <div class="toggle_thumb"></div>
    </div>
    </div>
<a href="/" class="home-logo-link">
  <img src="/icons/logo.png" alt="Home" class="home-logo">
</a>



<main class="content">
  <div class="container">
  <h1><%= title %></h1>
  <p style="text-align: center;">If you are new to the wiki please take some time to read <a href = "/getting-started" target="_blank">this guide</a> to help you get started</p>
 <div class="search-container">
  <form action="/search" method="GET" class="search-form">
    <input type="text" name="q" placeholder="Search pages">
    <button type="submit" class="search-btn" aria-label="Search">
      <img src="/icons/search.svg" alt="Search" class="search-icon">
    </button>
  </form>
</div>

<div class="actions">
  <form action="/create" method="GET">
    <button type="submit" class="btn-create">Create New Page</button>
  </form>
</div>

</form>
</form>



  <h2>Most Recent Pages</h2>
  <ul>
    <% recentPages.forEach(page => { %>
      <li>
        <a href="/<%= page.slug %>"><%= page.title %></a>
        (Updated: <%= new Date(page.updated_at).toLocaleString() %>)
      </li>
    <% }) %>
  </ul>

  <h2>Current Priority Updates</h2>
  <ul>
    <li>Getting started page</li>
    <li>Add support for linked headers in wikis </li>
    <li>Create grouping for different sections (ie. locations / characters)</li>
    <li>Improve search bar</li>
    <li>Improve general formatting</li>
  </ul>
  <h2>Patch Notes (Ver 1.0.1)</h2>
  <ul>
    <li>Added delete button in the edit pages of wikis</li>
    <li>Added getting started page to home</li>
    <li>Removed dev text and worked on general formatting</li>
  </ul>

 <script>
function dark_mode() {
  document.body.classList.toggle("dark_mode");

  localStorage.setItem(
    "darkMode",
    document.body.classList.contains("dark_mode") ? "true" : "false"
  );

  // Force CodeMirror to redraw (fixes cursor/colors)
  if (window.simplemde) {
    simplemde.codemirror.refresh();
  }
}

// Apply saved mode on load
if (localStorage.getItem("darkMode") === "true") {
  document.body.classList.add("dark_mode");
}
</script>
</div>
</main>
<footer>
    <p>created by ysa / @Yoshingo on discord</p>contact me on discord or at
    <a href="mailto:contact@yoshingo.org">contact@yoshingo.org</a></p>
</footer>

</body>

</html>
