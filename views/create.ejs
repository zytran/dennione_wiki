<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create New Page</title>
  <link rel="icon" href="/icons/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simplemde/dist/simplemde.min.css">


  <style>
    body {
      font-family: system-ui, Arial, sans-serif;
      max-width: 800px;
      margin: 2rem auto;
      line-height: 1.6;
      background-color: #f9f9f9;
      color: #111;
      transition: background-color 0.3s, color 0.3s;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .content {
      flex: 1;
    }

    h1 {
      text-align: center;
      color: #333;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
    }

    label {
      font-weight: bold;
    }

    button {
      width: 120px;
      padding: 0.5rem;
      font-size: 1rem;
      border: none;
      border-radius: 4px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
      align-self: flex-start;
    }
    input[type="text"], textarea 
    { padding: 0.5rem;
         font-size: 1rem; 
         border: 1px solid #ccc; 
         border-radius: 4px; 
         width: 100%; 
         box-sizing: border-box; }

    button:hover {
      background-color: #45a049;
    }

    .dark_mode{
        background-color: #333;
        color: #f9f9f9;   
    }
    .dark_mode h1{
        color: #f9f9f9;
    }
    .dark_mode .editor-toolbar,
    .dark_mode .CodeMirror{
        background-color: #222;
        color: #eee;
    }
    .dark_mode .CodeMirror-cursor{
        border-left: 1px solid #fff;
    }
    .dark_mode .actions a{
        background-color: #444;
        color:#eee;
        border-color: #666 ;
    }

    .dark_toggle{
        position: fixed;
        top: 1rem;
        right: 1rem;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }
   
.dark_mode .editor-toolbar {
  background-color: #2b2b2b;
  border-color: #444;
}

.dark_mode .editor-toolbar button {
  color: #ddd;
}

.dark_mode .editor-toolbar button:hover {
  background-color: #3a3a3a;
}

.dark_mode .CodeMirror {
  background-color: #1e1e1e;
  color: #f9f9f9;
  border-color: #444;
}

.dark_mode .CodeMirror-gutters {
  background-color: #1e1e1e;
  border-right: 1px solid #444;
}

.dark_mode .CodeMirror-cursor {
  border-left: 1px solid #fff;
}

.dark_mode .CodeMirror-selected {
  background-color: #555 !important;
}

.dark_mode .CodeMirror-line::selection,
.dark_mode .CodeMirror-line > span::selection {
  background-color: #555;
}


    h1 {
      text-align: center;
      color: #333;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
    }

    button {
      width: 120px;
      padding: 0.5rem;
      font-size: 1rem;
      border: none;
      border-radius: 4px;
      background-color: #4CAF50;
      color: white;
      cursor: pointer;
    }

    button:hover {
      background-color: #45a049;
    }

    .actions {
      margin-top: 1rem;
    }

    .actions a {
      text-decoration: none;
      color: #555;
      padding: 0.5rem 1rem;
      border: 1px solid #ccc;
      border-radius: 4px;
      background-color: #eee;
    }

    .actions a:hover {
      background-color: #ddd;
    }

 .theme_toggle {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 9999;
  cursor: pointer;
}

.toggle_track {
  width: 64px;
  height: 32px;
  background: #ddd;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6px;
  position: relative;
}

.toggle_thumb {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 26px;
  height: 26px;
  background: white;
  border-radius: 50%;
  transition: transform 0.3s ease;
}

.dark_mode .toggle_thumb {
  transform: translateX(45px);
}


.icon {
    width: 16px;
    height: 16px;
  font-size: 14px;
  z-index: 1;
}
.sun,
.moon {
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.dark_mode .sun {
  opacity: 0.3;
}

.dark_mode .moon {
  opacity: 1;
}

body:not(.dark_mode) .sun {
  opacity: 1;
}

body:not(.dark_mode) .moon {
  opacity: 0.3;
}

.dark_mode .toggle_track {
  background: #555;
}
.home-logo-link {
  position: fixed;   
  top: 1rem;         
  left: 1rem;        
  z-index: 1000;     
}

.home-logo {
  width: 144px;       
  height: 144px;
  cursor: pointer;   
  transition: opacity 0.3s;
}

.home-logo-link:hover .home-logo {
  opacity: 0.8;      
}

  </style>
</head>
  
  <div class="theme_toggle" onclick="dark_mode()">
    <div class="toggle_track">
      <img src="/icons/sun.svg" class="icon sun" alt="Light Mode">
      <img src="/icons/moon.svg" class="icon moon" alt="Dark Mode">
      <div class="toggle_thumb"></div>
    </div>
  </div>

  
  <a href="/" class="home-logo-link">
    <img src="/icons/logo.png" alt="Home" class="home-logo">
  </a>

  <header>
    <h1>Create New Page</h1>
  </header>

  <main>
    <div class="content">
      <% if (errors && errors.length > 0) { %>
        <ul>
          <% errors.forEach(e => { %>
            <li><%= e %></li>
          <% }) %>
        </ul>
      <% } %>

      <form action="/create" method="POST">
        <label for="title">Title</label>
        <input type="text" name="title" id="title" value="<%= page?.title || '' %>" required>

        <label for="slug">Slug (URL)</label>
        <input type="text" name="slug" id="slug" value="<%= page?.slug || '' %>" required>

        <label for="content">Content</label>
        <div class="instructions">
  <p>Currently the wiki uses markdown for formatting: <a href="https://www.markdownguide.org/cheat-sheet/">Here's a quick formatting guide for it</a></p>
  <p>I also didn't add support for images yet, but you can workaround that by using Discord to host images.</p>
  <p>Copy the image link from Discord and use the correct markdown to display it</p>
</div>
        <textarea id="editor" name="content"><%= page?.content || '' %></textarea>
        <button type="submit">Create Page</button>
      </form>
    </div>
  </main>

  <script>
    function dark_mode() {
      document.body.classList.toggle("dark_mode");
      localStorage.setItem("darkMode", document.body.classList.contains("dark_mode"));
    }

    if (localStorage.getItem("darkMode") === "true") {
      document.body.classList.add("dark_mode");
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/simplemde/dist/simplemde.min.js"></script>
<script>
  const simplemde = new SimpleMDE({
    element: document.getElementById("editor"),
    spellChecker: true,
    status: false,
    autosave: {
      enabled: true,
      uniqueId: "wiki-editor-<%= page?.slug || '' %>",
      delay: 1000
    }
  });
</script>

</body>
</html>
